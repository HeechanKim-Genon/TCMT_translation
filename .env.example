# 복사해서 .env 로 쓴다:  cp .env.example .env
# .env 는 .gitignore 되어 있다.

# ── 필수: API 키
GLM_KEY=여기에_번역모델_키
QWEN_KEY=여기에_생성모델_키

# ── 엔드포인트
# 최종 URL = {GENOS_BASE}/{SERVING}/v1/chat/completions
GENOS_BASE=https://genos.genon.ai/api/gateway/rep/serving
GLM_SERVING=813
QWEN_SERVING=752
GLM_MODEL=zai-org/glm-5.2
QWEN_MODEL=model

# ── 동작 설정
# 서빙의 최대 동시실행 설정에 맞춰 올린다
TCMT_WORKERS=12

# ── 경로 (기본값을 쓰려면 지워도 된다)
# TCMT_DICT=data/dictionary.csv
# TCMT_DICT_SAMPLE=data/dictionary_sample2000.csv
# TCMT_OUT=results
# TCMT_DATA=dataset
